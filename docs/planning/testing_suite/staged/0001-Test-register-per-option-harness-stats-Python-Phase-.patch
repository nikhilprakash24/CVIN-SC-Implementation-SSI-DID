+# Mapping rules for test bodies that record no structured result (TSR Phase 3, replan 2026-10-22 §3; WM-2 A7).
+# Read by docs/testing/build_register.py. Every entry it produces records which rule fired (`mapped_by`).
+# Order matters: first match wins. Correct a wrong mapping here, never in the generated register.
+about: >-
+  Subject from path; class and op from the test title and its describe chain. A test title is never edited
+  (replan R-2). Identifier TC-<sut>-<op>-<cls>-<hash8>, hash8 = sha1("path::describe::title")[:8] (replan R-3).
+
+sources:
+  mocha:
+    - 1_blockchain-identity/test/L2-identity-system/per-option
+    - 1_blockchain-identity/test/benchmarks
+    - phase2/idtx/test
+  pytest:
+    - 2_w3c-ssi-layer
+    - cv2x-testbed/tests
+    - sandbox/py-suites
+    - phase2/backends
+    - tools/run_identity
+
+subject_by_path:            # substring of the path -> subject (sandbox slug for chain options)
+  - [phase2/idtx/, phase2-idtx]
+  - [phase2/backends/, phase2-backends]
+  - [tools/run_identity/, pipeline]
+  - [per-option/CVINCombined/, cvin-combined]
+  - [per-option/ERC1056/CVINVehicleDIDRegistry, erc-1056-vehicle]
+  - [per-option/ERC1056/ERC1056Registry, mobi-vid]          # the MOBI layer's own ERC-1056 registry
+  - [per-option/ERC1056/, erc-1056-uport]                   # EthereumDIDRegistry, PseudonymPool
+  - [per-option/ERC1155/, erc-1155]
+  - [per-option/ERC4337/, erc-4337]
+  - [per-option/ERC721/, erc-721]
+  - [per-option/ERC725xy/, erc-725xy]
+  - [per-option/ERC735/, erc-735]
+  - [per-option/LSP8/, lsp8]
+  - [per-option/MOBIVID/, mobi-vid]
+  - [test/benchmarks/adapters.conformance, harness-adapters]
+  - [test/benchmarks/, pipeline]
+  - [did-resolution/tests/, did-resolver]
+  - [verifiable-credentials/tests/test_t3_testbed, v2v-path]
+  - [verifiable-credentials/tests/test_s3_key_binding, did-resolver]
+  - [verifiable-credentials/tests/, vc-layer]
+  - [mobi-vid/tests/, mobi-vid]
+  - [cv2x-testbed/tests/test_pki_certificate_chain, baseline-pki]
+  - [cv2x-testbed/tests/test_lifecycle_parity, baseline-centralized]
+  - [cv2x-testbed/tests/test_mobi_vid_verify, mobi-vid]
+  - [cv2x-testbed/tests/test_attack_scenarios_identity_theft, vc-layer]
+  - [cv2x-testbed/tests/test_t9_freshness, v2v-path]
+  - [cv2x-testbed/tests/test_t12_comparison_framework, pipeline]
+  - [cv2x-testbed/tests/test_experiment_harness, pipeline]
+  - [cv2x-testbed/tests/, cv2x-erc1056]                    # erc1056 provider: key resolution, freshness, D51
+  - [L3-ssi/test_external_did_conformance, did-resolver]
+  - [L3-ssi/test_internal_compliance_checker, vc-layer]
+  - [L3-ssi/test_infrastructure, infrastructure]
+  - [L3-ssi/test_mobi_provider, mobi-vid]
+  - [L4-exemplar-interactions/test_lifecycle_use_cases, use-cases]
+  - [L4-exemplar-interactions/test_v2v_harness, v2v-path]
+  - [L4-exemplar-interactions/, pipeline]
+
+class_by_path:              # whole-file class, checked before the title rules
+  - [tools/run_identity/test_promote, D]
+  - [regression.test.js, R]          # placeholder: resolved below to N or A by title; R kept only if neither fires
+  - [adapters.conformance, W]
+  - [test_external_did_conformance, W]
+  - [test_internal_compliance_checker, W]
+  - [test_did_resolver_metadata_shape, W]
+  - [test_lifecycle_use_cases, I]
+  - [test_lifecycle_parity, I]
+  - [test_experiment_records_are_well_formed, D]
+  - [test_experiment_harness, D]
+  - [test_t12_comparison_framework, D]
+  - [PseudonymPool, G]
+
+class_rules:                # [regex (case-insensitive), class]
+  - ["attack|attacker|hijack|replay|forg|tamper|theft|thief|steal|stolen|malleab|poison|bypass|impersonat|spoof|front-?run|sybil", A]
+  - ["\\bgas\\b|gasUsed|pinned", G]
+  - ["latenc|throughput|p95|percentile|bootstrap|mann|timing", L]
+  - ["should not|not allow|cannot|can't|reject|revert|invalid|fail|disallow|refuse|wrong|missing|expired|duplicate|non-owner|unauthori[sz]ed|unknown|malformed|forbid|only (the )?owner|onlyowner|must not", N]
+  - ["conform|DID Core|contentType|metadata shape|representation|ABNF|CAIP|datetime|schema|\\bspec\\b|specification", W]
+  - ["determinis|byte-identical|\\bseed|artifact|provenance|snapshot|\\bstamp", D]
+  - ["scale|scaling|O\\(1\\)|grows|history length|slope", S]
+
+op_rules:                   # [regex (case-insensitive), op or ops separated by ';']
+  - ["royalt|toll|payment|ERC-2981", misc]
+  - ["hybrid's core operations|core operations", "C1;U3;V3"]
+  - ["owner change|unauthori[sz]ed owner", U1]
+  - ["default owner", R1]
+  - ["\\bnonce\\b", U5]
+  - ["duplicate VIN|VIN length|VIN registration", C1]
+  - ["authori[sz]e\\b|authori[sz]ation", V1]
+  - ["did:ethr|zero-pads|40 hex", R3]
+  - ["status registry", V6]
+  - ["impostor|unknown vehicle", K4]
+  - ["chain id|two chains|matching chain|malformed chain|chain configured", K8]
+  - ["limitation is documented", misc]
+  - ["holder binding|holder control|identity theft|thief", K5]
+  - ["rpc snapshot|benchmark uses|untimed|normalCdf|mann|percentile|bootstrap", pipeline-stats]
+  - ["setAttributeSigned|meta-?tx|UserOp|handleOp|relay", U5]
+  - ["selective disclosure|disclos|salted|SD-JWT", K3]
+  - ["(?<!re)presentation|\\bVP\\b|challenge|domain", K5]
+  - ["schema", K7]
+  - ["contentType|resolveRepresentation|representation", K9]
+  - ["invalidDid|methodNotSupported|notFound|error code|unknown method|ABNF|CAIP", K10]
+  - ["vin.?cipher|AES|GCM|HKDF|encrypt|decrypt|VIN privacy|vin normalis|normaliz", K11]
+  - ["freshness|refresh|probe|staleness|chain.?time|clock", K12]
+  - ["pseudonym", M7]
+  - ["CRL|check_revocation|revocation status|isRevoked|is_revoked", M5]
+  - ["BSM|packet|stale|future|timestamp|ages out|replay cache|message", M3]
+  - ["certificate chain|trust_ca|trust anchor|CA signature|enrol|X\\.?509", M1]
+  - ["recover(y)? (the )?(owner|controller|account|identity)|guardian|social recovery|recoverOwner", U6]
+  - ["revokeDelegate|revoke.{0,25}delegate|removeKey|remove key", D1]
+  - ["revokeAttribute|revoke attribute|removeClaim|remove.{0,4}claim|revokeClaimContent", D2]
+  - ["deactivat|burn|end-of-life|end of life|decommission|revokeVehicle|renounce", D3]
+  - ["revoke_credential|revokeCredential|revoke credential|revocation|revoked|revoke", V5]
